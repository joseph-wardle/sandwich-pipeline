#usda 1.0
(
    "Chrome and grey reference spheres asset"
    defaultPrim = "ReferenceSpheres"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "ReferenceSpheres"
{
    def Scope "geo"
    {
        def Sphere "chrome"
        {
            float3[] extent = [(-0.045, -0.045, -0.045), (0.045, 0.045, 0.045)]
            double radius = 0.045
            double3 xformOp:translate = (0, 0.055, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "grey"
        {
            float3[] extent = [(-0.045, -0.045, -0.045), (0.045, 0.045, 0.045)]
            double radius = 0.045
            double3 xformOp:translate = (0, -0.055, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

