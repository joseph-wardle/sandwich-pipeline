#usda 1.0
(
    "Chrome and grey reference spheres asset"
    defaultPrim = "ReferenceSpheres"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "ReferenceSpheres"
{
    def Scope "geo"
    {
        def Sphere "chrome"
        {
            float3[] extent = [(-0.09, -0.09, -0.09), (0.09, 0.09, 0.09)]
            double radius = 0.09
            double3 xformOp:translate = (-0.1, 0.09, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "grey"
        {
            float3[] extent = [(-0.09, -0.09, -0.09), (0.09, 0.09, 0.09)]
            double radius = 0.09
            double3 xformOp:translate = (0.1, 0.09, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

