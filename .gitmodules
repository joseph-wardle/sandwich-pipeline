[submodule "pipeline/lib/dwpicker"]
	path = pipeline/lib/dwpicker
	url = https://github.com/DreamWall-Animation/dwpicker.git
[submodule "pipeline/lib/MOPS"]
	path = pipeline/lib/MOPS
	url = https://github.com/toadstorm/MOPS.git
	ignore = dirty
[submodule "pipeline/lib/VFX-LYNX"]
	path = pipeline/lib/VFX-LYNX
	url = https://github.com/LucaScheller/VFX-LYNX.git
[submodule "pipeline/software/nuke/tools/NukeSurvivalToolkit_publicRelease"]
	path = pipeline/software/nuke/tools/NukeSurvivalToolkit_publicRelease
	url = https://github.com/CreativeLyons/NukeSurvivalToolkit_publicRelease.git
[submodule "pipeline/lib/studiolibrary"]
	path = pipeline/lib/studiolibrary
	url = https://github.com/krathjen/studiolibrary.git
[submodule "pipeline/lib/modelChecker"]
	path = pipeline/lib/modelChecker
	url = https://github.com/JakobJK/modelChecker.git
[submodule "pipeline/lib/maya-timeline-marker"]
	path = pipeline/lib/maya-timeline-marker
	url = https://github.com/scottdmilner/maya-timeline-marker.git
[submodule "pipeline/lib/mayacapture/mayacapture"]
	path = pipeline/lib/mayacapture/mayacapture
	url = https://github.com/abstractfactory/maya-capture.git
[submodule "pipeline/lib/tractor-lops"]
	path = pipeline/lib/tractor-lops
	url = git@github.com:joseph-wardle/tractor-lops.git
	branch = prod
[submodule "pipeline/lib/aperture"]
	path = pipeline/lib/aperture
	url = git@github.com:michaelharmonart/aperture.git
	branch = main
[submodule "pipeline/lib/y-rig"]
	path = pipeline/lib/y-rig
	url = git@github.com:michaelharmonart/y-rig.git
[submodule "pipeline/lib/ae_SVG"]
	path = pipeline/lib/ae_SVG
	url = https://github.com/Aeoll/ae_SVG.git
