# Dialog script for skd::main::lookdev::2.0 automatically generated

{
    name	skd::main::lookdev::2.0
    script	skd::main::lookdev::2.0
    label	"SKD Lookdev"

    help {
    }

    inputlabel	1	"Asset"
    inputlabel	2	"Lights"

    parm {
        name    "framing"
        label   "Framing"
        type    string
        default { "fit" }
        help    "Fit to asset sizes the frame from the asset's bounds. Manual sets its width in meters."
        menu {
            "fit"       "Fit to asset"
            "manual"    "Manual"
        }
    }
    parm {
        name    "padding"
        label   "Padding"
        type    float
        default { "1.25" }
        help    "Frame width as a multiple of the circle the asset sweeps as it turns, or of its height for tall assets. The frame widens further when the references need room."
        hidewhen "{ framing == manual }"
        range   { 1 3 }
    }
    parm {
        name    "frame_width"
        label   "Frame Width"
        type    float
        default { "4" }
        help    "Width of the view at the asset, in meters."
        hidewhen "{ framing == fit }"
        range   { 0.1 50 }
        parmtag { "units" "m1" }
    }
    parm {
        name    "camera_angle"
        label   "Camera Angle"
        type    float
        default { "10" }
        help    "Degrees the camera looks down at the asset. Raise it for flat assets such as rugs, decals or maps."
        range   { 0! 90! }
    }
    parm {
        name    "rig"
        label   "Lighting Rig"
        type    ordinal
        default { "0" }
        help    "Built-in lights. Ignored while the Lights input is connected."
        menu {
            "studio"    "Studio"
            "dramatic"  "Dramatic"
        }
    }
    parm {
        name    "backdrop"
        label   "Backdrop"
        type    string
        default { "checker" }
        help    "Checker shows scale in half-meter squares. Solid is a single color for demo reels."
        menu {
            "checker"   "Checker"
            "solid"     "Solid"
        }
    }
    parm {
        name    "backdrop_color"
        label   "Color"
        type    color
        size    3
        default { "1" "1" "1" }
        help    "Backdrop albedo, scene-linear ACEScg."
        hidewhen "{ backdrop == checker }"
        range   { 0 1 }
    }
    parm {
        name    "show_references"
        label   "Show References"
        type    toggle
        default { "1" }
        help    "Color checker on camera right, chrome and grey spheres on camera left."
    }
    groupsimple {
        name    "turnaround"
        label   "Turnaround"

        parm {
            name    "rotate_asset"
            label   "Rotate Asset"
            type    toggle
            default { "1" }
            help    "Turn the asset once over the frame range, or over its first half when the lights turn too."
        }
        parm {
            name    "rotate_lights"
            label   "Rotate Lights"
            type    toggle
            default { "1" }
            help    "Turn the lights once over the frame range, or over its second half when the asset turns too."
        }
    }

}
